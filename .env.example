# ==========================================
# HEALTH MONITORING PLATFORM - ENV CONFIG
# ==========================================

# Port API Gateway
PORT=3000

# Base de données MongoDB (Utilisateurs et Alertes)
# Docker: mongodb://mongo:27017/healthdb | Local: mongodb://localhost:27017/healthdb
MONGO_URI=mongodb://localhost:27017/healthdb

# Base de données TimescaleDB / PostgreSQL (Signes vitaux)
# Docker: DB_HOST=timescaledb | Local: DB_HOST=localhost
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=timescale
PG_CONN=postgresql://postgres:postgres@localhost:5432/timescale

# Broker Redis Pub/Sub
# Docker: redis://redis:6379 | Local: redis://localhost:6379
REDIS_URI=redis://localhost:6379
REDIS_URL=redis://localhost:6379
VITALS_CHANNEL=vitals-channel
ALERTS_CHANNEL=alerts-channel

# Clé secrète JWT
JWT_SECRET=supersecretjwtkeypfe2025

# Service Machine Learning
# Docker: http://ml-service:5000/predict | Local: http://localhost:5000/predict
ML_SERVICE_URL=http://localhost:5000/predict
ML_URL=http://localhost:5000/predict

# Simulateur d'objets connectés
# Docker: http://api-gateway:3000 | Local: http://localhost:3000
API_URL=http://localhost:3000
